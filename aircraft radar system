
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#include <SDL.h>
#include <SDL_ttf.h>
#include <curl/curl.h>
#include "cJSON.h"

// ------------ SETTINGS ------------

#define ESP32_IP "192.168.1.100"

#define HOME_LAT 11.0168
#define HOME_LON 76.9558

#define RADAR_RADIUS_KM 150.0

#define WINDOW_W 900
#define WINDOW_H 900

#define CENTER_X (WINDOW_W / 2)
#define CENTER_Y (WINDOW_H / 2)

#define RADAR_R 350

#define MAX_DATA 60000

// ------------ DATA ------------

typedef struct
{
    double lat;
    double lon;
    double altitude;
    double speed;
    double track;

    char callsign[32];

} Aircraft;

static Aircraft aircraft[500];

static int aircraft_count = 0;

static char http_data[MAX_DATA];

static size_t http_size = 0;

// ------------ CURL ------------

static size_t write_callback(
    void *contents,
    size_t size,
    size_t nmemb,
    void *userp)
{
    size_t total = size * nmemb;

    if (http_size + total >= MAX_DATA)
    {
        return 0;
    }

    memcpy(
        http_data + http_size,
        contents,
        total);

    http_size += total;

    http_data[http_size] = '\0';

    return total;
}

// ------------ FETCH DATA ------------

static int fetch_aircraft(void)
{
    CURL *curl = curl_easy_init();

    if (!curl)
    {
        return 0;
    }

    char url[256];

    snprintf(
        url,
        sizeof(url),
        "http://%s/aircraft",
        ESP32_IP);

    http_size = 0;

    memset(
        http_data,
        0,
        sizeof(http_data));

    curl_easy_setopt(
        curl,
        CURLOPT_URL,
        url);

    curl_easy_setopt(
        curl,
        CURLOPT_WRITEFUNCTION,
        write_callback);

    curl_easy_setopt(
        curl,
        CURLOPT_WRITEDATA,
        NULL);

    curl_easy_setopt(
        curl,
        CURLOPT_TIMEOUT,
        10L);

    CURLcode result =
        curl_easy_perform(curl);

    curl_easy_cleanup(curl);

    if (result != CURLE_OK)
    {
        printf(
            "HTTP error: %s\n",
            curl_easy_strerror(result));

        return 0;
    }

    cJSON *root =
        cJSON_Parse(http_data);

    if (!root)
    {
        printf("JSON parsing failed\n");

        return 0;
    }

    cJSON *list =
        cJSON_GetObjectItem(
            root,
            "aircraft");

    aircraft_count = 0;

    cJSON *item = NULL;

    cJSON_ArrayForEach(item, list)
    {
        if (aircraft_count >= 500)
        {
            break;
        }

        Aircraft *plane =
            &aircraft[aircraft_count];

        cJSON *lat =
            cJSON_GetObjectItem(
                item,
                "lat");

        cJSON *lon =
            cJSON_GetObjectItem(
                item,
                "lon");

        cJSON *alt =
            cJSON_GetObjectItem(
                item,
                "alt");

        cJSON *speed =
            cJSON_GetObjectItem(
                item,
                "speed");

        cJSON *track =
            cJSON_GetObjectItem(
                item,
                "track");

        cJSON *callsign =
            cJSON_GetObjectItem(
                item,
                "callsign");

        if (!cJSON_IsNumber(lat) ||
            !cJSON_IsNumber(lon))
        {
            continue;
        }

        plane->lat =
            lat->valuedouble;

        plane->lon =
            lon->valuedouble;

        plane->altitude =
            cJSON_IsNumber(alt)
            ? alt->valuedouble
            : 0;

        plane->speed =
            cJSON_IsNumber(speed)
            ? speed->valuedouble
            : 0;

        plane->track =
            cJSON_IsNumber(track)
            ? track->valuedouble
            : 0;

        snprintf(
            plane->callsign,
            sizeof(plane->callsign),
            "%s",
            cJSON_IsString(callsign)
            ? callsign->valuestring
            : "UNKNOWN");

        aircraft_count++;
    }

    cJSON_Delete(root);

    printf(
        "Aircraft received: %d\n",
        aircraft_count);

    return 1;
}

// ------------ DRAW TEXT ------------

static void draw_text(
    SDL_Renderer *renderer,
    TTF_Font *font,
    const char *text,
    int x,
    int y,
    SDL_Color color)
{
    SDL_Surface *surface =
        TTF_RenderText_Solid(
            font,
            text,
            color);

    if (!surface)
    {
        return;
    }

    SDL_Texture *texture =
        SDL_CreateTextureFromSurface(
            renderer,
            surface);

    SDL_Rect rect =
    {
        x,
        y,
        surface->w,
        surface->h
    };

    SDL_RenderCopy(
        renderer,
        texture,
        NULL,
        &rect);

    SDL_FreeSurface(surface);

    SDL_DestroyTexture(texture);
}

// ------------ RADAR CIRCLE ------------

static void draw_circle(
    SDL_Renderer *renderer,
    int cx,
    int cy,
    int radius)
{
    for (int angle = 0;
         angle < 360;
         angle++)
    {
        double rad =
            angle * M_PI / 180.0;

        int x1 =
            cx + radius * cos(rad);

        int y1 =
            cy + radius * sin(rad);

        int x2 =
            cx + radius * cos(rad + 0.01);

        int y2 =
            cy + radius * sin(rad + 0.01);

        SDL_RenderDrawLine(
            renderer,
            x1, y1,
            x2, y2);
    }
}

// ------------ DRAW RADAR ------------

static void draw_radar(
    SDL_Renderer *renderer,
    TTF_Font *font)
{
    SDL_SetRenderDrawColor(
        renderer,
        0, 0, 0, 255);

    SDL_RenderClear(renderer);

    SDL_Color green =
    {
        0, 220, 70, 255
    };

    SDL_SetRenderDrawColor(
        renderer,
        0, 120, 40, 255);

    // Distance rings
    for (int km = 30;
         km <= 150;
         km += 30)
    {
        int radius =
            (int)(
                RADAR_R *
                km /
                RADAR_RADIUS_KM);

        draw_circle(
            renderer,
            CENTER_X,
            CENTER_Y,
            radius);

        char label[32];

        snprintf(
            label,
            sizeof(label),
            "%d km",
            km);

        draw_text(
            renderer,
            font,
            label,
            CENTER_X + 5,
            CENTER_Y - radius,
            green);
    }

    // Crosshair
    SDL_RenderDrawLine(
        renderer,
        CENTER_X - RADAR_R,
        CENTER_Y,
        CENTER_X + RADAR_R,
        CENTER_Y);

    SDL_RenderDrawLine(
        renderer,
        CENTER_X,
        CENTER_Y - RADAR_R,
        CENTER_X,
        CENTER_Y + RADAR_R);

    // Center point
    SDL_SetRenderDrawColor(
        renderer,
        0, 255, 0, 255);

    SDL_Rect center =
    {
        CENTER_X - 4,
        CENTER_Y - 4,
        8,
        8
    };

    SDL_RenderFillRect(
        renderer,
        &center);

    // Aircraft
    for (int i = 0;
         i < aircraft_count;
         i++)
    {
        Aircraft *plane =
            &aircraft[i];

        double x_km =
            (plane->lon - HOME_LON)
            * 111.32
            * cos(
                HOME_LAT *
                M_PI / 180.0);

        double y_km =
            (plane->lat - HOME_LAT)
            * 111.0;

        int x =
            CENTER_X +
            (int)(
                x_km *
                RADAR_R /
                RADAR_RADIUS_KM);

        int y =
            CENTER_Y -
            (int)(
                y_km *
                RADAR_R /
                RADAR_RADIUS_KM);

        // Aircraft blip
        SDL_SetRenderDrawColor(
            renderer,
            255, 30, 30, 255);

        SDL_Rect dot =
        {
            x - 4,
            y - 4,
            8,
            8
        };

        SDL_RenderFillRect(
            renderer,
            &dot);

        // Aircraft label
        char label[128];

        snprintf(
            label,
            sizeof(label),
            "%s %.0f ft %.0f kt",
            plane->callsign,
            plane->altitude * 3.28084,
            plane->speed * 1.94384);

        draw_text(
            renderer,
            font,
            label,
            x + 8,
            y - 12,
            green);
    }

    // Heading
    draw_text(
        renderer,
        font,
        "N",
        CENTER_X - 5,
        CENTER_Y - RADAR_R - 25,
        green);

    draw_text(
        renderer,
        font,
        "E",
        CENTER_X + RADAR_R + 10,
        CENTER_Y - 5,
        green);

    draw_text(
        renderer,
        font,
        "S",
        CENTER_X - 5,
        CENTER_Y + RADAR_R + 10,
        green);

    draw_text(
        renderer,
        font,
        "W",
        CENTER_X - RADAR_R - 25,
        CENTER_Y - 5,
        green);

    // Title
    draw_text(
        renderer,
        font,
        "ESP32 AIR TRAFFIC RADAR",
        15,
        15,
        green);

    char count[64];

    snprintf(
        count,
        sizeof(count),
        "Aircraft: %d",
        aircraft_count);

    draw_text(
        renderer,
        font,
        count,
        15,
        40,
        green);

    SDL_RenderPresent(renderer);
}

// ------------ MAIN ------------

int main(int argc, char *argv[])
{
    (void)argc;
    (void)argv;

    if (SDL_Init(SDL_INIT_VIDEO) != 0)
    {
        printf("SDL initialization failed\n");

        return 1;
    }

    if (TTF_Init() != 0)
    {
        printf("TTF initialization failed\n");

        SDL_Quit();

        return 1;
    }

    curl_global_init(
        CURL_GLOBAL_DEFAULT);

    SDL_Window *window =
        SDL_CreateWindow(
            "ESP32 Flight Radar",
            SDL_WINDOWPOS_CENTERED,
            SDL_WINDOWPOS_CENTERED,
            WINDOW_W,
            WINDOW_H,
            SDL_WINDOW_SHOWN);

    SDL_Renderer *renderer =
        SDL_CreateRenderer(
            window,
            -1,
            SDL_RENDERER_ACCELERATED);

    TTF_Font *font =
        TTF_OpenFont(
            "arial.ttf",
            14);

    if (!font)
    {
        printf(
            "Font not found: arial.ttf\n");

        return 1;
    }

    int running = 1;

    SDL_Event event;

    Uint32 last_update = 0;

    while (running)
    {
        while (SDL_PollEvent(&event))
        {
            if (event.type == SDL_QUIT)
            {
                running = 0;
            }
        }

        Uint32 now = SDL_GetTicks();

        // Fetch every 15 seconds
        if (now - last_update >= 15000)
        {
            fetch_aircraft();

            last_update = now;
        }

        draw_radar(
            renderer,
            font);

        SDL_Delay(50);
    }

    TTF_CloseFont(font);

    SDL_DestroyRenderer(renderer);

    SDL_DestroyWindow(window);

    curl_global_cleanup();

    TTF_Quit();

    SDL_Quit();

    return 0;
}
